<p style="margin:0 0 4px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:<%= @status == "cancelled" ? "#dc2626" : "#4f46e5" %>;">Order update</p>
<h1 style="margin:0 0 12px;font-size:24px;color:#18181b;"><%= @copy[:headline] %></h1>
<p style="margin:0;font-size:15px;line-height:1.6;color:#3f3f46;">Hi <%= @customer_name %>, <%= @copy[:body] %></p>

<% unless @status == "cancelled" %>
  <% reached = @timeline.index(@status) || 0 %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:24px 0 0;">
    <tr>
      <% @timeline.each_with_index do |step, i| %>
        <td style="text-align:center;font-size:12px;padding:0 4px;">
          <div style="height:6px;border-radius:6px;background:<%= i <= reached ? "#4f46e5" : "#e4e4e7" %>;"></div>
          <div style="margin-top:8px;text-transform:capitalize;font-weight:<%= i == reached ? 700 : 500 %>;color:<%= i <= reached ? "#18181b" : "#a1a1aa" %>;"><%= step %></div>
        </td>
      <% end %>
    </tr>
  </table>
<% end %>

<%= render "summary" %>
