<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:24px 0 8px;">
  <tr>
    <td style="padding:12px 16px;background:#f5f5f7;border-radius:12px;font-size:13px;color:#525266;">
      <strong style="color:#18181b;">Order <%= @order.order_number %></strong>
      &nbsp;·&nbsp; Placed <%= @order.created_at.strftime("%-d %b %Y, %H:%M") %>
      &nbsp;·&nbsp; Status: <strong style="color:#4f46e5;text-transform:capitalize;"><%= @order.status %></strong>
    </td>
  </tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;color:#18181b;">
  <tr style="color:#71717a;font-size:12px;text-transform:uppercase;letter-spacing:.04em;">
    <td style="padding:10px 0;border-bottom:1px solid #e4e4e7;">Item</td>
    <td style="padding:10px 0;border-bottom:1px solid #e4e4e7;text-align:center;">Qty</td>
    <td style="padding:10px 0;border-bottom:1px solid #e4e4e7;text-align:right;">Price</td>
    <td style="padding:10px 0;border-bottom:1px solid #e4e4e7;text-align:right;">Total</td>
  </tr>
  <% @items.each do |item| %>
    <tr>
      <td style="padding:12px 0;border-bottom:1px solid #f4f4f5;font-weight:600;"><%= item.product_name %></td>
      <td style="padding:12px 0;border-bottom:1px solid #f4f4f5;text-align:center;"><%= item.quantity %></td>
      <td style="padding:12px 0;border-bottom:1px solid #f4f4f5;text-align:right;"><%= inr(item.price) %></td>
      <td style="padding:12px 0;border-bottom:1px solid #f4f4f5;text-align:right;font-weight:600;"><%= inr(item.total) %></td>
    </tr>
  <% end %>
  <tr><td colspan="3" style="padding:10px 0 2px;text-align:right;color:#71717a;">Subtotal</td><td style="padding:10px 0 2px;text-align:right;"><%= inr(@order.subtotal) %></td></tr>
  <tr><td colspan="3" style="padding:2px 0;text-align:right;color:#71717a;">Shipping</td><td style="padding:2px 0;text-align:right;"><%= @order.shipping_fee.to_d.zero? ? "Free" : inr(@order.shipping_fee) %></td></tr>
  <tr><td colspan="3" style="padding:2px 0;text-align:right;color:#71717a;">Tax (GST 18%)</td><td style="padding:2px 0;text-align:right;"><%= inr(@order.tax) %></td></tr>
  <tr><td colspan="3" style="padding:12px 0;text-align:right;font-weight:700;font-size:16px;">Order total</td><td style="padding:12px 0;text-align:right;font-weight:700;font-size:16px;color:#4f46e5;"><%= inr(@order.total) %></td></tr>
</table>

<% lines = address_lines(@address) %>
<% if lines.any? %>
  <p style="margin:24px 0 6px;font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:#71717a;">Shipping to</p>
  <p style="margin:0;font-size:14px;line-height:1.6;color:#18181b;"><%= safe_join(lines, tag.br) %></p>
<% end %>

<p style="margin:32px 0 0;">
  <a href="<%= @orders_url %>" style="display:inline-block;background:#4f46e5;color:#ffffff;text-decoration:none;font-weight:700;font-size:14px;padding:12px 22px;border-radius:12px;">View your order</a>
</p>
